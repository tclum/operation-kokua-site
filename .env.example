# Indexing switch. Exactly "true" makes the site indexable; anything else (or
# unset) keeps it noindex. While src/content/unconfirmed.ts lists any item,
# "true" fails the build (the launch gate).
SITE_INDEXABLE=false

# The donation record (pnpm record:*). Both are server-only: read only by
# scripts/record/db.ts, never by the site, never prefixed NEXT_PUBLIC_.
# SUPABASE_URL: Supabase dashboard, project operation-kokua, Settings > API (the project URL).
SUPABASE_URL=
# SUPABASE_SECRET_KEY: same page, API keys, a secret key (sb_secret_...); never commit or print it.
SUPABASE_SECRET_KEY=
